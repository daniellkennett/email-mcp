# FALLBACK CONFIGURATION ONLY.
#
# The primary place for these settings is the "env" block of the email-marketing entry in
# your Claude config -- see the README "Settings" section and claude_desktop_config.example.json:
#   Claude Desktop: ~/Library/Application Support/Claude/claude_desktop_config.json
#   Claude Code:    ~/.claude.json
#
# This file still works if you prefer running the server from a terminal. Real environment
# variables take precedence over it, so anything set in the Claude config wins over a value
# here. Copy to .env (gitignored) and fill in.
#
# Copy this file to .env in the project root and fill in real values.
# .env is gitignored. Real credentials belong only in .env, never in this example file
# and never in git. Restart the MCP server after editing .env (settings load once per process).
#
# Format: one KEY=value per line. Put comments on their own lines. Do not add trailing
# comments after a value, and do not quote values, because they become part of the value.

# ------------------------------------------------------------------
# 1. SMTP relay (REQUIRED). Use exactly ONE provider block below.
# ------------------------------------------------------------------

# Option A: Mailgun
# Host smtp.mailgun.org, port 587 with STARTTLS.
# SMTP_USER is the SMTP login for your Mailgun sending domain (postmaster@<sending-domain>).
# SMTP_PASSWORD is the SMTP credential password from that domain's SMTP settings page, NOT your API key.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASSWORD=replace-with-mailgun-smtp-password
# SMTP_STARTTLS=true

# Option B: SendGrid
# Host smtp.sendgrid.net, port 587 with STARTTLS.
# SMTP_USER is the literal word apikey.
# SMTP_PASSWORD is a SendGrid API key with the Mail Send permission (starts with SG.).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.replace-with-sendgrid-api-key
# SMTP_STARTTLS=true

# ------------------------------------------------------------------
# 2. Sender identity
# ------------------------------------------------------------------

# The From address recipients see. Must be on a domain you have verified with the relay.
FROM_EMAIL=rose@starsupportus.com

# Optional display name shown next to the From address. Default: Star Support.
# FROM_NAME=Star Support

# Optional Reply-To address for replies. Leave unset to reply to FROM_EMAIL.
# REPLY_TO=rose@starsupportus.com

# ------------------------------------------------------------------
# 3. Compliance
# ------------------------------------------------------------------

# Base URL of an endpoint YOU control that records opt-outs. Each email gets an unsubscribe
# link built from this, plus a List-Unsubscribe header that expects one-click POSTs. The endpoint
# must actually process opt-outs, because this server only stores suppressions locally. Leave it
# unset and sent mail has no footer and no unsubscribe header. See the the README "Safety and compliance" section.
# Replace the example below with your real endpoint.
# UNSUBSCRIBE_BASE_URL=https://your-unsubscribe-endpoint.example/opt-out

# ------------------------------------------------------------------
# 4. Safety caps and pacing (optional; commented values are the engine defaults)
# ------------------------------------------------------------------

# Safe default: true means send tools dry-run unless the caller passes dry_run=false explicitly.
# Leave this true unless you deliberately want real sends by default.
DRY_RUN_DEFAULT=true

# Maximum recipients in a single send run. Larger runs are refused.
# MAX_RECIPIENTS_PER_RUN=2000

# Maximum messages sent in any trailing hour.
# MAX_MESSAGES_PER_HOUR=5000   # default is 400 when SMTP_HOST is an ionos host

# Messages per SMTP batch, and the pause between batches in seconds.
# BATCH_SIZE=50
# BATCH_PAUSE_SECONDS=2.0

# ------------------------------------------------------------------
# 5. Directories (optional; relative paths are resolved from the project root)
# ------------------------------------------------------------------

# Defaults: templates, contacts, state. Relative paths resolve from the project root.
# TEMPLATE_DIR=templates
# CONTACTS_DIR=contacts
# STATE_DIR=state
